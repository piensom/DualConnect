{
  "name": "dual-connect",
  "version": "1.0.0",
  "description": "Educational platform connecting students with Ausbildung and Duales Studium programs in Germany",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "cypress run",
    "cypress:open": "cypress open",
    "lint": "eslint src backend",
    "migrate:up": "node backend/migrations/migrate.js up",
    "migrate:down": "node backend/migrations/migrate.js down",
    "migrate:create": "node backend/migrations/migrate.js create",
    "seed": "node backend/scripts/seed.js",
    "backup": "node backend/scripts/backup.js",
    "backup:full": "node backend/scripts/backup.js backup --compress --s3",
    "backup:restore": "node backend/scripts/backup.js restore",
    "seo:generate": "node -e \"require('./backend/utils/seo').saveSitemap(); require('./backend/utils/seo').saveRobotsTxt()\"",
    "docker:build": "docker-compose -f docker-compose.full-stack.yml build",
    "docker:up": "docker-compose -f docker-compose.full-stack.yml up -d",
    "docker:down": "docker-compose -f docker-compose.full-stack.yml down",
    "docker:logs": "docker-compose -f docker-compose.full-stack.yml logs -f"
  },
  "keywords": ["education", "ausbildung", "duales-studium", "germany", "platform"],
  "author": "Dual Connect Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "nodemailer": "^6.9.7",
    "multer": "^1.4.5-lts.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "compression": "^1.7.4",
    "xss": "^1.0.14",
    "redis": "^4.6.11",
    "winston": "^3.11.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "bull": "^4.12.0",
    "@sentry/node": "^7.99.0",
    "@sentry/profiling-node": "^1.3.3",
    "ws": "^8.16.0",
    "speakeasy": "^2.0.0",
    "qrcode": "^1.5.3",
    "axios": "^1.6.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/dom": "^9.3.3",
    "cypress": "^13.6.2",
    "nodemon": "^3.0.2",
    "eslint": "^8.55.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/scripts/**/*.js",
      "backend/**/*.js",
      "!backend/node_modules/**"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ]
  }
}
